  "dialogues": {
    "S01": [
      [
        "伤员",
        "灯又灭了……水声比昨夜更近。"
      ],
      [
        "岚",
        "这盏还有余温。我去储藏间找备用灯芯。"
      ],
      [
        "伤员",
        "别走暗处。沿着地上的灯线，箱子就在门后。"
      ]
    ],
    "S02": [
      [
        "岚",
        "旧灯芯烧裂了。把备用芯装进去……"
      ],
      [
        "岚",
        "光没有散开，它在杖端聚成了一束。"
      ],
      [
        "提示",
        "净光已解锁：右键朝向目标释放。先净化灯座右侧不攻击的教学孢囊；完成后才有主动敌人。"
      ]
    ],
    "M1": [
      [
        "岚",
        "门亮了。灯芯里多出一道稳住的光。"
      ],
      [
        "提示",
        "初燃：生命上限100→110。守灯结已获得：生命上限再+10。请选择一项强化；关闭或跳过对白不会替你选择。"
      ]
    ],
    "S03": [
      [
        "绒",
        "这些刻痕不是爪印。水位退下去一格，我们就划一道。"
      ],
      [
        "岚",
        "最后一道还很湿。营地却说，是菌群先袭击了水管。"
      ],
      [
        "绒",
        "我们先失去的是水，不是耐心。顺着旧矿道走，你会看见管子的另一端。"
      ],
      [
        "岚",
        "我会去看。你留在这盏灯旁，别跟进暗处。"
      ]
    ],
    "L01": [
      [
        "矿工刻字",
        "“水退第三格。灯还能亮，别把管子全堵死。”"
      ],
      [
        "岚",
        "刻痕被反复描过。写它的人，也许早就知道水位在下降。"
      ]
    ],
    "L02": [
      [
        "回声",
        "三束光从这间屋子被引向矿门。有人拆走了导线，把灯座留在这里。"
      ],
      [
        "岚",
        "不是菌群扯断的。至少这一处，不是。"
      ]
    ]
  },
