extends RefCounted
## Pixel-prop / furniture / ambient renderer for 《菌灯之下》 G3.
##
## All hand-drawn prop pixels live in res://assets/props/props_data.json
## (generated by tools/gen_props.py from the original 16x16 tileset palette).
## Static furniture is drawn directly from res://assets/original/Tilesets/Complete.png
## with draw_texture_rect_region, plus a thin hard-pixel animation layer.
##
## Style contract:
##   * integer world coordinates only (the world canvas is 320x180 scaled 4x);
##   * 1 px dark outline, <=16 colours per prop, binary alpha, no gradients;
##   * every variant has 3..6 idle frames; reduced_motion freezes on rest_frame;
##   * low_effects halves particle counts; reduced_flash dims glow layers.
##
## Public API (integration contract, see docs/g3/props-art.md):
##   draw_prop(canvas, kind, pos, state, tick, prefs)
##   draw_furniture(canvas, kind, pos, tick, prefs, state := {})
##   draw_ambient(canvas, kind, pos, tick, prefs)
##   label_anchor(kind) -> Vector2          # world-pixel offset from pos
##   particle_budget(prefs) -> int
##
## state keys: lit, available, scanned, open, dir (0..3), correct, complete, near.
## dir follows campaign.gd DIR_VECTORS: 0=up, 1=right, 2=down, 3=left.
## Optional extra keys: beam (guide beam on/off, default true), color (reserved).

const DATA_PATH := "res://assets/props/props_data.json"
const TILESET := preload("res://assets/original/Tilesets/Complete.png")
const GUIDE_DIRS := {
	0: Vector2.UP,
	1: Vector2.RIGHT,
	2: Vector2.DOWN,
	3: Vector2.LEFT,
}
const AMBIENT_KINDS := ["spores", "dust", "drip", "ember", "light_pool", "sway"]

var data: Dictionary = {}
var palette: Dictionary = {}
var palette_bytes: Dictionary = {}
var loaded := false
var load_error := ""

var draws := 0
var furniture_draws := 0
var ambient_draws := 0

var _textures: Dictionary = {}


func _init() -> void:
	load_data()


func load_data() -> void:
	loaded = false
	load_error = ""
	var text := FileAccess.get_file_as_string(DATA_PATH)
	if text.is_empty():
		load_error = "props_data.json not found at " + DATA_PATH
		push_error(load_error)
		return
	var parsed = JSON.parse_string(text)
	if typeof(parsed) != TYPE_DICTIONARY:
		load_error = "props_data.json is not a JSON object"
		push_error(load_error)
		return
	data = parsed
	if int(data.get("schema_version", 0)) < 1:
		load_error = "props_data.json has no schema_version"
		push_error(load_error)
		data = {}
		return
	var colors: Dictionary = data.get("palette", {}).get("colors", {})
	for ch in colors.keys():
		var col := Color(str(colors[ch]))
		palette[str(ch)] = col
		palette_bytes[str(ch)] = PackedByteArray([
			int(round(col.r * 255.0)), int(round(col.g * 255.0)), int(round(col.b * 255.0)), 255])
	loaded = true


# ---------------------------------------------------------------------------
# Kind resolution / state
# ---------------------------------------------------------------------------
func resolve_kind(kind: String) -> String:
	var k := kind
	var aliases: Dictionary = data.get("aliases", {})
	var kinds: Dictionary = data.get("kinds", {})
	var furniture: Dictionary = data.get("furniture", {})
	for i in 8:
		if kinds.has(k) or furniture.has(k):
			return k
		if not aliases.has(k):
			return k
		k = str(aliases[k])
	return k


func has_kind(kind: String) -> bool:
	var k := resolve_kind(kind)
	return data.get("kinds", {}).has(k) or data.get("furniture", {}).has(k)


func is_furniture(kind: String) -> bool:
	return data.get("furniture", {}).has(resolve_kind(kind))


func variant_for(kind: String, state: Dictionary) -> String:
	var k := resolve_kind(kind)
	if not data.get("kinds", {}).has(k):
		return ""
	var def: Dictionary = data["kinds"][k]
	var variants: Dictionary = def.get("variants", {})
	var v := str(def.get("default_variant", "idle"))
	var lit := bool(state.get("lit", false))
	var available := bool(state.get("available", true))
	var scanned := bool(state.get("scanned", false))
	var is_open := bool(state.get("open", false))
	var correct := bool(state.get("correct", false))
	var complete := bool(state.get("complete", false))
	var direction := clampi(int(state.get("dir", 3)), 0, 3)
	match k:
		"lamp":
			v = "lit" if lit else "unlit"
		"chest":
			if is_open:
				v = "open"
			elif not available:
				v = "dim"
			else:
				v = "closed"
		"door":
			v = "open" if is_open else ("lit" if available else "sealed")
		"pipe":
			v = "scanned" if scanned else "idle"
		"ring":
			v = "complete" if complete else "idle"
		"guide":
			v = "d%d%s" % [direction, "c" if correct else "w"]
		"guide_target":
			v = "on" if correct else "off"
		"mine_door":
			if is_open:
				v = "open"
			elif not available:
				v = "sealed_scan" if scanned else "sealed"
			else:
				v = "lit"
	if not variants.has(v):
		v = str(def.get("default_variant", variants.keys()[0] if not variants.is_empty() else "idle"))
	if not variants.has(v) and not variants.is_empty():
		v = str(variants.keys()[0])
	return v


func frame_index(variant_def: Dictionary, tick: int, prefs) -> int:
	var frames: Array = variant_def.get("frames", [])
	if frames.is_empty():
		return 0
	var count := frames.size()
	var rest := clampi(int(variant_def.get("rest_frame", 0)), 0, count - 1)
	if _pref(prefs, "reduced_motion"):
		return rest
	var hold := maxi(1, int(variant_def.get("hold", 8)))
	var frame := posmod(int(tick) / hold, count)
	if _pref(prefs, "reduced_flash"):
		var flash: Array = variant_def.get("flash_frames", [])
		for flash_frame in flash:
			if int(flash_frame) == frame:
				return rest
	return frame


func frame_count(kind: String, variant: String) -> int:
	var def: Dictionary = data.get("kinds", {}).get(resolve_kind(kind), {})
	var vdef: Dictionary = def.get("variants", {}).get(variant, {})
	return (vdef.get("frames", []) as Array).size()


# ---------------------------------------------------------------------------
# Pixels -> textures
# ---------------------------------------------------------------------------
func texture_for(kind: String, variant: String, frame: int) -> Texture2D:
	var key := "%s/%s/%d" % [kind, variant, frame]
	if _textures.has(key):
		return _textures[key]
	var def: Dictionary = data.get("kinds", {}).get(kind, {})
	var vdef: Dictionary = def.get("variants", {}).get(variant, {})
	var frames: Array = vdef.get("frames", [])
	if frames.is_empty():
		return null
	var rows: Array = frames[clampi(frame, 0, frames.size() - 1)]
	var size := Vector2i(int(def["size"][0]), int(def["size"][1]))
	var image := image_for_rows(rows, size)
	if image == null:
		return null
	var texture := ImageTexture.create_from_image(image)
	_textures[key] = texture
	return texture


func image_for_rows(rows: Array, size: Vector2i) -> Image:
	if rows.size() != size.y:
		push_error("prop frame row count %d != height %d" % [rows.size(), size.y])
		return null
	var bytes := PackedByteArray()
	bytes.resize(size.x * size.y * 4)
	var i := 0
	for y in size.y:
		var row := str(rows[y])
		for x in size.x:
			if x >= row.length() or row[x] == ".":
				bytes[i] = 0
				bytes[i + 1] = 0
				bytes[i + 2] = 0
				bytes[i + 3] = 0
			else:
				var pb: PackedByteArray = palette_bytes.get(row[x], PackedByteArray([255, 0, 255, 255]))
				bytes[i] = pb[0]
				bytes[i + 1] = pb[1]
				bytes[i + 2] = pb[2]
				bytes[i + 3] = 255
			i += 4
	return Image.create_from_data(size.x, size.y, false, Image.FORMAT_RGBA8, bytes)


# ---------------------------------------------------------------------------
# Geometry
# ---------------------------------------------------------------------------
func prop_rect(kind: String, pos: Vector2) -> Rect2:
	var k := resolve_kind(kind)
	if not data.get("kinds", {}).has(k):
		return Rect2()
	var def: Dictionary = data["kinds"][k]
	var anchor: Array = def["anchor"]
	return Rect2(pos.round() + Vector2(int(anchor[0]), int(anchor[1])),
		Vector2(int(def["size"][0]), int(def["size"][1])))


func furniture_rect(kind: String, pos: Vector2) -> Rect2:
	var k := resolve_kind(kind)
	var def: Dictionary = data.get("furniture", {}).get(k, {})
	if def.is_empty():
		return prop_rect(kind, pos)
	if def.has("prop"):
		return prop_rect(str(def["prop"]), pos)
	var near: Array = def.get("near_rect", [-8, -8, 16, 16])
	return Rect2(pos.round() + Vector2(int(near[0]), int(near[1])),
		Vector2(int(near[2]), int(near[3])))


func label_anchor(kind: String) -> Vector2:
	var k := resolve_kind(kind)
	var source: Dictionary = data.get("kinds", {})
	if not source.has(k):
		source = data.get("furniture", {})
	if not source.has(k):
		return Vector2.ZERO
	var anchor: Array = source[k].get("label_anchor", [0, -16])
	return Vector2(int(anchor[0]), int(anchor[1]))


func sprite_size(kind: String) -> Vector2:
	var k := resolve_kind(kind)
	if data.get("kinds", {}).has(k):
		var size: Array = data["kinds"][k]["size"]
		return Vector2(int(size[0]), int(size[1]))
	var rect := furniture_rect(k, Vector2.ZERO)
	return rect.size


func guide_beam_origin(pos: Vector2) -> Vector2:
	return pos.round() + Vector2(0, -17)


# ---------------------------------------------------------------------------
# Public drawing API
# ---------------------------------------------------------------------------
func draw_prop(canvas: CanvasItem, kind: String, pos: Vector2, state: Dictionary, tick: int, prefs) -> void:
	draws += 1
	if canvas == null:
		return
	var k := resolve_kind(kind)
	if data.get("kinds", {}).has(k):
		_draw_prop_sprite(canvas, k, pos, state, tick, prefs)
	elif data.get("furniture", {}).has(k):
		draw_furniture(canvas, k, pos, tick, prefs, state)


func draw_furniture(canvas: CanvasItem, kind: String, pos: Vector2, tick: int, prefs, state: Dictionary = {}) -> void:
	furniture_draws += 1
	if canvas == null:
		return
	var k := resolve_kind(kind)
	var def: Dictionary = data.get("furniture", {}).get(k, {})
	if def.is_empty():
		return
	if def.has("prop"):
		_draw_prop_sprite(canvas, str(def["prop"]), pos, state, tick, prefs)
		return
	var base := pos.round()
	var layers: Array = def.get("layers", [])
	for layer in layers:
		var r: Array = layer["rect"]
		var off: Array = layer["offset"]
		var src := Rect2(int(r[0]), int(r[1]), int(r[2]), int(r[3]))
		var dst := Rect2(base + Vector2(int(off[0]), int(off[1])), src.size)
		canvas.draw_texture_rect_region(TILESET, dst, src)
	_draw_furniture_fx(canvas, k, base, tick, prefs, state)
	if bool(state.get("near", false)):
		_draw_near(canvas, furniture_rect(k, base))


func draw_ambient(canvas: CanvasItem, kind: String, pos: Vector2, tick: int, prefs) -> void:
	ambient_draws += 1
	if canvas == null:
		return
	var adef: Dictionary = data.get("ambient", {}).get("kinds", {}).get(kind, {})
	if adef.is_empty():
		return
	var colors: Array = adef.get("colors", [])
	if colors.is_empty():
		return
	var alpha := float(adef.get("alpha", 0.8))
	if _pref(prefs, "reduced_flash"):
		alpha *= 0.65
	if kind == "light_pool":
		_draw_light_pool(canvas, pos, tick, prefs, adef, alpha)
		return
	if kind == "sway":
		_draw_sway(canvas, pos, tick, prefs, adef, alpha)
		return
	var points := ambient_positions(kind, pos, tick, prefs)
	for i in points.size():
		var p: Vector2 = points[i]
		var col: Color = palette.get(str(colors[i % colors.size()]), Color.WHITE)
		col.a = alpha
		canvas.draw_rect(Rect2(p, Vector2.ONE), col)


# ---------------------------------------------------------------------------
# Ambient budget / deterministic particles
# ---------------------------------------------------------------------------
func particle_budget(prefs) -> int:
	var base := int(data.get("ambient", {}).get("budget", 24))
	if _pref(prefs, "low_effects"):
		return int(ceili(base / 2.0))
	return base


func ambient_count(kind: String, prefs) -> int:
	var adef: Dictionary = data.get("ambient", {}).get("kinds", {}).get(kind, {})
	if adef.is_empty():
		return 0
	var base := int(adef.get("base_count", 0))
	if base <= 0:
		return 0
	var count := base
	if _pref(prefs, "low_effects"):
		count = int(ceili(base / 2.0))
	return mini(count, particle_budget(prefs))


func ambient_positions(kind: String, pos: Vector2, tick: int, prefs) -> Array:
	var out: Array = []
	var count := ambient_count(kind, prefs)
	if count <= 0:
		return out
	var t := 0 if _pref(prefs, "reduced_motion") else int(tick)
	var cx := int(pos.x)
	var cy := int(pos.y)
	match kind:
		"spores":
			for i in count:
				var x := cx - 17 + posmod(i * 13 + posmod(t / 24 + i, 3), 34)
				var y := cy - 2 - posmod(t / 6 + i * 9, 26)
				out.append(Vector2(x, y))
		"dust":
			for i in count:
				var x := cx - 20 + posmod(i * 17 + t / 8, 40)
				var y := cy - 1 - posmod(i * 5, 7)
				out.append(Vector2(x, y))
		"drip":
			for i in count:
				var tt := posmod(t + i * 28, 56)
				var bx := cx + i * 6 - 3
				if tt < 24:
					out.append(Vector2(bx, cy - 12 + tt / 2))
				elif tt < 32:
					var splash: Vector2 = [Vector2(-2, 0), Vector2(0, 0), Vector2(2, 0)][tt % 3]
					out.append(Vector2(bx + int(splash.x), cy - 1))
		"ember":
			for i in count:
				var x := cx - 3 + posmod(i * 7 + posmod(t / 20 + i, 3), 7)
				var y := cy - 18 - posmod(t / 5 + i * 7, 20)
				out.append(Vector2(x, y))
		_:
			pass
	return out


# ---------------------------------------------------------------------------
# Prop internals
# ---------------------------------------------------------------------------
func _draw_prop_sprite(canvas: CanvasItem, k: String, pos: Vector2, state: Dictionary, tick: int, prefs) -> void:
	var def: Dictionary = data["kinds"][k]
	var variant := variant_for(k, state)
	var variants: Dictionary = def.get("variants", {})
	if variants.is_empty():
		return
	if not variants.has(variant):
		variant = str(variants.keys()[0])
	var vdef: Dictionary = variants[variant]
	var frame := frame_index(vdef, tick, prefs)
	var texture := texture_for(k, variant, frame)
	if texture == null:
		return
	var anchor: Array = def["anchor"]
	var rect := Rect2(pos.round() + Vector2(int(anchor[0]), int(anchor[1])), texture.get_size())
	_draw_ground_shadow(canvas, def, pos)
	canvas.draw_texture_rect(texture, rect, false)
	if k == "guide" and bool(state.get("beam", true)):
		_draw_guide_beam(canvas, pos, state, tick, prefs)
	if bool(state.get("near", false)):
		_draw_near(canvas, rect)


func _draw_ground_shadow(canvas: CanvasItem, def: Dictionary, pos: Vector2) -> void:
	var width := int(def["size"][0])
	var anchor: Array = def["anchor"]
	var ground := int(def.get("ground", int(def["size"][1]) - 1))
	var gy := pos.round().y + int(anchor[1]) + ground
	var half := maxi(3, int(width * 0.4))
	var col := Color(0.02, 0.03, 0.02, 0.30)
	var p := pos.round()
	for dx in range(-half, half + 1):
		if posmod(dx, 3) == 0:
			continue
		canvas.draw_rect(Rect2(Vector2(p.x + dx, gy), Vector2.ONE), col)


func _draw_near(canvas: CanvasItem, rect: Rect2) -> void:
	var col: Color = palette.get("Y", Color("ddc161"))
	col.a = 0.9
	var r := Rect2(rect.position - Vector2.ONE, rect.size + Vector2(2, 2))
	var arm := 5.0
	var corners := [
		[Vector2(r.position.x, r.position.y), Vector2(1, 1)],
		[Vector2(r.end.x - arm, r.position.y), Vector2(1, 1)],
		[Vector2(r.position.x, r.end.y - 1), Vector2(1, -1)],
		[Vector2(r.end.x - arm, r.end.y - 1), Vector2(1, -1)],
	]
	for c in corners:
		var origin: Vector2 = c[0]
		var sx: float = c[1].x
		canvas.draw_rect(Rect2(origin, Vector2(arm, 1)), col)
		var vertical_origin := Vector2(origin.x if sx > 0 else r.end.x - 1, origin.y)
		canvas.draw_rect(Rect2(vertical_origin, Vector2(1, arm)), col)


func _draw_guide_beam(canvas: CanvasItem, pos: Vector2, state: Dictionary, tick: int, prefs) -> void:
	if not bool(state.get("available", true)):
		return
	var direction := clampi(int(state.get("dir", 3)), 0, 3)
	var correct := bool(state.get("correct", false))
	var axis: Vector2 = GUIDE_DIRS[direction]
	var colors := ["F", "Y", "W"]
	if not correct:
		colors = ["q", "z", "q"]
	if _pref(prefs, "reduced_flash") and correct:
		colors = ["Y", "y", "Y"]
	var phase := 0
	if not _pref(prefs, "reduced_motion"):
		phase = posmod(int(tick / 4), 6)
	var length := 16 if _pref(prefs, "low_effects") else 26
	var origin := guide_beam_origin(pos)
	var perpendicular := Vector2(axis.y, axis.x)
	for dist in range(4, length):
		if posmod(dist + phase, 6) >= 4:
			continue
		for w in [-1, 0, 1]:
			if w != 0 and posmod(dist + w, 2) == 0:
				continue
			var p := origin + axis * float(dist) + perpendicular * float(w)
			var col: Color = palette.get(str(colors[0] if w == 0 else colors[1]), Color.WHITE)
			col.a = 0.85 if w == 0 else 0.50
			canvas.draw_rect(Rect2(p.round(), Vector2.ONE), col)


# ---------------------------------------------------------------------------
# Furniture animation layer
# ---------------------------------------------------------------------------
func _draw_furniture_fx(canvas: CanvasItem, k: String, base: Vector2, tick: int, prefs, state: Dictionary) -> void:
	var def: Dictionary = data["furniture"][k]
	var fx: Dictionary = def.get("fx", {})
	match k:
		"torch":
			if not bool(state.get("lit", true)):
				return
		"wall_panel", "wall_panel_red", "wall_panel_cyan":
			if not bool(state.get("lit", true)):
				return
	var fx_tick := 0 if _pref(prefs, "reduced_motion") else int(tick)
	for item in fx.get("glow", []):
		_fx_pulse(canvas, base, item, fx_tick, prefs)
	for item in fx.get("pulse", []):
		_fx_pulse(canvas, base, item, fx_tick, prefs)
	for item in fx.get("seam", []):
		_fx_seam(canvas, base, item, fx_tick, prefs)
	for item in fx.get("flame", []):
		_fx_flame(canvas, base, item, fx_tick, prefs)
	for item in fx.get("motes", []):
		_fx_motes(canvas, base, item, fx_tick, prefs)
	for item in fx.get("spores", []):
		_fx_spores(canvas, base, item, fx_tick, prefs)
	for item in fx.get("dust", []):
		_fx_dust(canvas, base, item, fx_tick, prefs)
	for item in fx.get("sparkle", []):
		_fx_sparkle(canvas, base, item, fx_tick, prefs)


func _fx_origin(base: Vector2, item: Dictionary) -> Vector2:
	var origin: Array = item.get("origin", [0, 0])
	return base + Vector2(int(origin[0]), int(origin[1]))


func _fx_pulse(canvas: CanvasItem, base: Vector2, item: Dictionary, tick: int, prefs) -> void:
	var center: Array = item.get("center", [0, 0])
	var radii: Array = item.get("radii", item.get("radius", [4, 4]))
	var rx := maxi(1, int(radii[0]))
	var ry := maxi(1, int(radii[1]))
	var cols: Array = item.get("colors", ["y"])
	var alpha := float(item.get("alpha", 0.18)) * 0.8
	if _pref(prefs, "reduced_flash"):
		alpha *= 0.7
	var phase := posmod(int(tick / maxi(1, int(item.get("hold", 8)))), 3)
	var cx := int(base.x) + int(center[0])
	var cy := int(base.y) + int(center[1])
	for dy in range(-ry, ry + 1):
		for dx in range(-rx, rx + 1):
			var d := float(dx * dx) / float(rx * rx) + float(dy * dy) / float(ry * ry)
			if d > 1.0:
				continue
			var ring := 0 if d < 0.35 else (1 if d < 0.7 else 2)
			if _pref(prefs, "low_effects") and ring == 2:
				continue
			var step := 2 + ring
			if posmod(dx + dy + phase + ring * 2, step) != 0:
				continue
			var col: Color = palette.get(str(cols[mini(ring, cols.size() - 1)]), Color.WHITE)
			col.a = alpha * (1.0 - 0.25 * float(ring))
			canvas.draw_rect(Rect2(Vector2(cx + dx, cy + dy), Vector2.ONE), col)


func _fx_seam(canvas: CanvasItem, base: Vector2, item: Dictionary, tick: int, prefs) -> void:
	var origin := _fx_origin(base, item)
	var width := int(item.get("width", 12))
	var cols: Array = item.get("colors", ["y"])
	var phase := posmod(int(tick / maxi(1, int(item.get("hold", 8)))), 3)
	var alpha := 0.58
	if _pref(prefs, "reduced_flash"):
		alpha *= 0.75
	for i in width:
		if posmod(i + phase, 3) == 0:
			continue
		var col: Color = palette.get(str(cols[posmod(i + phase, cols.size())]), Color.WHITE)
		col.a = alpha
		canvas.draw_rect(Rect2(origin + Vector2(i, 0), Vector2.ONE), col)


func _fx_flame(canvas: CanvasItem, base: Vector2, item: Dictionary, tick: int, prefs) -> void:
	var origin := _fx_origin(base, item)
	var cols: Array = item.get("colors", ["F", "W", "Y", "y"])
	var hold := maxi(1, int(item.get("hold", 5)))
	var frame := posmod(int(tick / hold), 3)
	var shapes := [
		[Vector2(1, 0), Vector2(1, 1), Vector2(2, 1), Vector2(0, 2), Vector2(1, 2), Vector2(2, 2), Vector2(0, 3), Vector2(1, 3), Vector2(1, 4)],
		[Vector2(0, 1), Vector2(1, 1), Vector2(1, 2), Vector2(2, 2), Vector2(0, 3), Vector2(1, 3), Vector2(2, 3), Vector2(1, 4)],
		[Vector2(1, 0), Vector2(2, 1), Vector2(1, 1), Vector2(0, 2), Vector2(1, 2), Vector2(2, 2), Vector2(0, 3), Vector2(1, 3), Vector2(1, 4)],
	]
	var shape: Array = shapes[frame]
	for i in shape.size():
		var p: Vector2 = shape[i]
		var col: Color = palette.get(str(cols[i % cols.size()]), Color.WHITE)
		col.a = 0.95
		canvas.draw_rect(Rect2(origin + p, Vector2.ONE), col)


func _fx_sparkle(canvas: CanvasItem, base: Vector2, item: Dictionary, tick: int, prefs) -> void:
	var hold := maxi(1, int(item.get("hold", 16)))
	var phase := posmod(int(tick / hold), 6)
	if phase >= 2:
		return
	var cols: Array = item.get("colors", ["Y"])
	var points: Array = item.get("points", [])
	var alpha := 0.7 if phase == 0 else 0.4
	if _pref(prefs, "reduced_flash"):
		alpha *= 0.7
	for i in points.size():
		var p: Array = points[i]
		var col: Color = palette.get(str(cols[i % cols.size()]), Color.WHITE)
		col.a = alpha
		canvas.draw_rect(Rect2(base + Vector2(int(p[0]), int(p[1])), Vector2.ONE), col)


func _fx_motes(canvas: CanvasItem, base: Vector2, item: Dictionary, tick: int, prefs) -> void:
	var origin := _fx_origin(base, item)
	var count := int(item.get("count", 2))
	if _pref(prefs, "low_effects"):
		count = maxi(1, int(ceili(count / 2.0)))
	var cols: Array = item.get("colors", ["Y"])
	var spread: Array = item.get("spread", [8, 6])
	var rise := maxi(1, int(item.get("rise", 10)))
	var hold := maxi(1, int(item.get("hold", 8)))
	var t := int(tick / hold)
	var alpha := 0.5
	if _pref(prefs, "reduced_flash"):
		alpha *= 0.75
	for i in count:
		var x := int(origin.x) + posmod(i * 13 + posmod(t + i, 3) - 1, maxi(1, int(spread[0]))) - int(spread[0]) / 2
		var y := int(origin.y) - posmod(t / 2 + i * 5, rise)
		var col: Color = palette.get(str(cols[i % cols.size()]), Color.WHITE)
		col.a = alpha
		canvas.draw_rect(Rect2(Vector2(x, y), Vector2.ONE), col)


func _fx_spores(canvas: CanvasItem, base: Vector2, item: Dictionary, tick: int, prefs) -> void:
	var origin := _fx_origin(base, item)
	var count := int(item.get("count", 2))
	if _pref(prefs, "low_effects"):
		count = maxi(1, int(ceili(count / 2.0)))
	var cols: Array = item.get("colors", ["z"])
	var spread: Array = item.get("spread", [10, 8])
	var rise := maxi(1, int(item.get("rise", 10)))
	var hold := maxi(1, int(item.get("hold", 10)))
	var t := int(tick / hold)
	var alpha := 0.45
	if _pref(prefs, "reduced_flash"):
		alpha *= 0.75
	for i in count:
		var x := int(origin.x) + posmod(i * 7 + posmod(t + i, 3) - 1, maxi(1, int(spread[0]))) - int(spread[0]) / 2
		var y := int(origin.y) - posmod(t + i * 4, rise)
		var col: Color = palette.get(str(cols[i % cols.size()]), Color.WHITE)
		col.a = alpha
		canvas.draw_rect(Rect2(Vector2(x, y), Vector2.ONE), col)


func _fx_dust(canvas: CanvasItem, base: Vector2, item: Dictionary, tick: int, prefs) -> void:
	var origin := _fx_origin(base, item)
	var count := int(item.get("count", 3))
	if _pref(prefs, "low_effects"):
		count = maxi(1, int(ceili(count / 2.0)))
	var cols: Array = item.get("colors", ["P"])
	var spread: Array = item.get("spread", [12, 6])
	var hold := maxi(1, int(item.get("hold", 12)))
	var t := int(tick / hold)
	var alpha := 0.32
	if _pref(prefs, "reduced_flash"):
		alpha *= 0.75
	for i in count:
		var x := int(origin.x) + posmod(i * 17 + t / 2, maxi(1, int(spread[0]))) - int(spread[0]) / 2
		var y := int(origin.y) + posmod(i * 3, maxi(1, int(spread[1])))
		var col: Color = palette.get(str(cols[i % cols.size()]), Color.WHITE)
		col.a = alpha
		canvas.draw_rect(Rect2(Vector2(x, y), Vector2.ONE), col)


# ---------------------------------------------------------------------------
# Ambient light fields
# ---------------------------------------------------------------------------
func _draw_light_pool(canvas: CanvasItem, pos: Vector2, tick: int, prefs, adef: Dictionary, alpha: float) -> void:
	var radii: Array = adef.get("radii", [18, 5])
	var rx := maxi(1, int(radii[0]))
	var ry := maxi(1, int(radii[1]))
	var cols: Array = adef.get("colors", ["a", "y"])
	var phase := posmod(int(tick / maxi(1, int(adef.get("hold", 6)))), 3)
	var cx := int(pos.x)
	var cy := int(pos.y)
	for dy in range(-ry, ry + 1):
		for dx in range(-rx, rx + 1):
			var d := float(dx * dx) / float(rx * rx) + float(dy * dy) / float(ry * ry)
			if d > 1.0:
				continue
			var ring := 0 if d < 0.35 else (1 if d < 0.7 else 2)
			if _pref(prefs, "low_effects") and ring == 2:
				continue
			var step := 2 + ring
			if posmod(dx + dy + phase + ring * 2, step) != 0:
				continue
			var col: Color = palette.get(str(cols[mini(ring, cols.size() - 1)]), Color.WHITE)
			col.a = alpha * (1.0 - 0.25 * float(ring))
			canvas.draw_rect(Rect2(Vector2(cx + dx, cy + dy), Vector2.ONE), col)


func _draw_sway(canvas: CanvasItem, pos: Vector2, tick: int, prefs, adef: Dictionary, alpha: float) -> void:
	var length := maxi(1, int(adef.get("length", 26)))
	var cols: Array = adef.get("colors", ["y"])
	var sway := 0
	if not _pref(prefs, "reduced_motion"):
		sway = [0, 1, 2, 1, 0, -1, -2, -1][posmod(int(tick / maxi(1, int(adef.get("hold", 8)))), 8)]
	var phase := posmod(int(tick / 8), 3)
	var cx := int(pos.x)
	var cy := int(pos.y)
	for dy in length:
		if _pref(prefs, "low_effects") and dy % 2 == 1:
			continue
		var half := 2 + dy / 4
		var lean := int(round(float(sway) * float(dy) / 12.0))
		for dx in range(-half, half + 1):
			if posmod(dx + dy + phase, 3) == 0:
				continue
			var col: Color = palette.get(str(cols[0]), Color.WHITE)
			col.a = alpha
			canvas.draw_rect(Rect2(Vector2(cx + dx + lean, cy + dy), Vector2.ONE), col)


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
func _pref(prefs, key: String, fallback := false) -> bool:
	if prefs == null:
		return fallback
	if prefs is Dictionary:
		return bool((prefs as Dictionary).get(key, fallback))
	var value = prefs.get(key)
	if value == null:
		return fallback
	return bool(value)


